<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The Nyx System Manager's actions: each kind of system change is its own. -->
<policyconfig>
  <vendor>NyxOS</vendor>
  <vendor_url>https://github.com/nyxos-project/nyx-system</vendor_url>

  <action id="io.github.nyxos_project.system.settings">
    <description>Change system settings</description>
    <message>Authentication is required to change system settings: the computer's name, time zone, language, keyboard, themes, or what the lid and power button do</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.nyxos_project.system.packages">
    <description>Install or remove software for everyone</description>
    <message>Authentication is required to install or remove software for every user</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.nyxos_project.system.services">
    <description>Turn system services on or off</description>
    <message>Authentication is required to turn system services on or off</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.nyxos_project.system.defaults">
    <description>Change every user's defaults</description>
    <message>Authentication is required to change the defaults every user starts with</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.nyxos_project.system.update">
    <description>Update the system</description>
    <message>Authentication is required to update NyxOS</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.nyxos_project.system.rollback">
    <description>Go back to an earlier system</description>
    <message>Authentication is required to go back to the previous version of the system</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.nyxos_project.system.groups">
    <description>Give an account access to containers, virtual machines or devices</description>
    <message>Authentication is required to change which groups an account is in. Some, like docker, give as much access as an administrator</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.nyxos_project.system.apply">
    <description>Change the system</description>
    <message>Authentication is required to apply system changes: settings, software for every user, services or group memberships</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="io.github.nyxos_project.system.firewall">
    <description>Change the firewall</description>
    <message>Authentication is required to turn the firewall on or off, or open ports in it</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.nyxos_project.system.clean">
    <description>Free space on the system</description>
    <message>Authentication is required to remove old system generations, unused packages or old system logs</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.nyxos_project.system.accounts">
    <description>Manage people's accounts</description>
    <message>Authentication is required to add or remove accounts, change their names or administrator rights, or set someone else's password</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.nyxos_project.system.password">
    <description>Change your password</description>
    <message>Authentication is required to change your password</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
  <action id="io.github.nyxos_project.system.mounts">
    <description>Mount drives and shares at startup</description>
    <message>Authentication is required to change which drives and network shares are mounted at startup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
